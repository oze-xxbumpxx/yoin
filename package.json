{
  "name": "yoin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration-tests.ts",
    "db:generate": "drizzle-kit generate --config=db/drizzle.config.ts",
    "check:migrations": "node scripts/check-migrations.ts",
    "build:web": "vite build apps/web",
    "build:lambda": "node scripts/build-lambda.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@typescript-eslint/parser": "8.74.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "5.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "3.1178.0",
    "@aws-sdk/client-ssm": "3.930.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  }
}
